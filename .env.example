# Server-only. If set, takes priority over a key saved in the UI.
KIE_API_KEY=

# Optional overrides (defaults shown)
# KIE_API_BASE_URL=https://api.kie.ai
# KIE_UPLOAD_BASE_URL=https://kieai.redpandaai.co
# KIE_DATA_DIR=./data

# Optional webhooks — only with a public tunnel URL pointing at this app.
# Polling keeps working without them.
# KIE_WEBHOOK_ENABLED=1
# KIE_PUBLIC_URL=https://your-tunnel.example.com
# KIE_WEBHOOK_HMAC_KEY=
